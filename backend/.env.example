# ---- core ----
# "development" ONLY on your own PC. Anything else = production (strict secrets, HSTS).
ENVIRONMENT=development
# Swagger /docs (route map). Keep false on servers; true is handy locally.
ENABLE_DOCS=true
DATABASE_URL=sqlite:///./agency.db
# REQUIRED in production. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ---- who may call the API from a browser (no trailing slash) ----
# production example: https://nextgenanalytics.cloud-ip.cc,http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Admin Panel URL (used inside password-reset emails). Admin is private -> localhost.
ADMIN_URL=http://localhost:5174

# ---- first admin account (only used when the users table is empty) ----
ADMIN_EMAIL=admin@nextgenanalytics.cloud-ip.cc
# Dev: leave blank -> a random password is printed once in the backend console.
# Prod: set a strong one (10+ chars) for the FIRST deploy, then delete this line.
ADMIN_PASSWORD=
ADMIN_NAME=Muhammad Affaf

# ---- admin-API invisibility key ----
# REQUIRED in production (32+ chars). Without the X-Admin-Key header every
# non-public API route answers 404. Put the SAME value in frontend-admin/.env
# as VITE_ADMIN_API_KEY. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
# Blank is allowed only in development.
ADMIN_API_KEY=

# ---- optional hardening ----
# Only these IPs can reach admin API routes (public routes unaffected). Blank = off.
ADMIN_ALLOWED_IPS=
# true only when behind Render/Nginx/Cloudflare so real client IPs are detected
TRUST_PROXY=false

# ---- AI (optional; blank = built-in smart replies, no cost) ----
OPENAI_API_KEY=
GROQ_API_KEY=

# ---- Gmail SMTP for Forgot Password (blank = link printed in console) ----
# Use a Gmail App Password: myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=NextGen Agency OS

# ---- portfolio (pulled live from GitHub) ----
GITHUB_USERNAME=affaf12
GITHUB_TOKEN=
PORTFOLIO_EXCLUDE_REPOS=affaf12.github.io,nextgen-agency-os
